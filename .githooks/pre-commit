#!/bin/sh
# Pre-commit: scans the staged diff for secrets (private keys, cloud and API tokens, passwords in URLs, .env files).
# Same file in every hexbe repo. Enable once per clone with:  git config core.hooksPath .githooks
# False positive? Add an entry with a reason to .secret-scan-allow. Last resort: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if command -v node >/dev/null 2>&1 && [ -f scripts/secret-scan.mjs ]; then
    node scripts/secret-scan.mjs --staged || {
        echo "pre-commit: secret scan failed, commit aborted." >&2
        exit 1
    }
else
    echo "pre-commit: node or scripts/secret-scan.mjs not found, secret scan SKIPPED." >&2
fi

# core.hooksPath hides .git/hooks, so run a pre-commit hook that was installed there before (husky and friends).
legacy="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$legacy" ] && [ "$legacy" != "$0" ]; then
    exec "$legacy" "$@"
fi
